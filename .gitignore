# ==== Entorno y credenciales ====
.env
*.env

# ==== Datos ====
# El dataset crudo y los archivos procesados se regeneran ejecutando
# el pipeline (ver README -> "Reproducibilidad"). No se versionan por
# su tamaño (el archivo fuente pesa ~40-130 MB).
Data/raw/*
!Data/raw/.gitkeep
Data/processed/*
!Data/processed/.gitkeep

# ==== Python ====
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.ipynb_checkpoints/
.venv/
venv/
env/

# ==== Editores / IDE ====
.vscode/
.idea/
*.swp

# ==== Sistema operativo ====
.DS_Store
Thumbs.db


